[alias]
lg1 = log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all --no-merges
lg2 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all --no-merges
lg3 = log --graph --abbrev-commit --decorate --all --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(dim white) - %an%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n %C(white)%s%C(reset)'
lg = !"git lg1"
st = status
please = push --force-with-lease
[user]
	name = pronvis
	email = stanislav.pirx@gmail.com
	signingkey = 1C4550749F86516E
[pull]
        rebase = true
[rebase]
        autoStash = true
[merge]
	# builtin tool: `git mergetool` opens the 4-way nvim layout (LOCAL/BASE/REMOTE
	# + merged buffer). Day-to-day resolution goes through diffview instead
	# (`:DiffviewOpen` on a conflicted repo); this is the CLI fallback.
	tool = nvimdiff
	# zdiff3: conflict markers carry a `|||||||` base section, so a hand-edited
	# conflict shows what the common ancestor said, not just the two sides.
	conflictStyle = zdiff3
[push]
	default = simple
[core]
	editor = nvim
	autocrlf = input
	excludesfile = ~/.gitignore
[diff]
	# builtin tool name; plain `nvim` is not one (`difftool.nvim.cmd not set`)
	tool = nvimdiff
[color "status"]
	changed = 203
	untracked = brightmagenta
	added = brightgreen
    branch = brightgreen
    localBranch = brightgreen
    remoteBranch = 203
[color "diff"]
	new = brightgreen
	old = 203
[commit]
	gpgsign = true
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
