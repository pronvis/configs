{
  "attribution": {
    "commitTrailers": false
  },
  "effortLevel": "high",
  "enabledPlugins": {
    "cloudflare@cloudflare": true,
    "compound-engineering@compound-engineering-plugin": false,
    "everything-claude-code@everything-claude-code": true,
    "excalidraw@excalidraw-skill": true,
    "mattpocock-skills@claude-plugins-official": true,
    "revdiff@revdiff": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "env": {
    "ECC_DISABLED_HOOKS": "pre:bash:gateguard-fact-force,pre:edit-write:gateguard-fact-force"
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "repo": "cloudflare/skills",
        "source": "github"
      }
    },
    "compound-engineering-plugin": {
      "source": {
        "repo": "EveryInc/compound-engineering-plugin",
        "source": "github"
      }
    },
    "everything-claude-code": {
      "source": {
        "repo": "affaan-m/everything-claude-code",
        "source": "github"
      }
    },
    "excalidraw-skill": {
      "source": {
        "repo": "edwingao28/excalidraw-skill",
        "source": "github"
      }
    },
    "revdiff": {
      "source": {
        "repo": "umputun/revdiff",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/tmux-claude-status.sh waiting",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog"
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/tmux-claude-status.sh working",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/tmux-claude-status.sh waiting",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/rustfmt.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/tmux-claude-status.sh working",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/tmux-claude-status.sh working",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/tmux-claude-status.sh gone",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/tmux-claude-status.sh idle",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/rust-review-reminder.sh",
            "type": "command"
          },
          {
            "command": "bash ~/.claude/hooks/tmux-claude-status.sh idle",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/tmux-claude-status.sh working",
            "type": "command"
          }
        ]
      }
    ]
  },
  "language": "English",
  "outputStyle": "Concise",
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "voiceEnabled": true
}
