# claude/settings.json is a live runtime store: ~/.claude/settings.json symlinks
# to it, so Claude Code writes to it whenever you `/model`, and it re-serialises
# the whole file (key order is not stable) producing diffs with no real change.
#
# The clean filter canonicalises what git stores:
#   jq -S             sort keys, so reordering never shows up as a diff
#   del(.model)       the per-machine model choice, rewritten on every `/model`
#   del(.modelSettings)  per-model effort etc; Claude Code adds an entry per
#                     model you use, so it accumulates the same way
#
# Everything else (hooks, env, enabledPlugins, effortLevel, statusLine) stays
# tracked. Requires jq, and the filter itself (see install.sh: setup_git_filters).
claude/settings.json filter=claude-settings

# codex/config.toml is also a live runtime store. Keep shared behavior tracked,
# but omit the machine-local model choice and Codex-generated project trust
# tables from Git's clean representation. The working file is left untouched.
# The filter is versioned in scripts/agents/codex-settings-clean and registered per
# clone by install.sh:setup_git_filters.
codex/config.toml filter=codex-settings
